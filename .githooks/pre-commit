#!/usr/bin/env sh
set -eu

echo "[hook:pre-commit] running clang-format check"
./scripts/dev/format.sh --staged --check

echo "[hook:pre-commit] running style checks"
./scripts/dev/style-check.sh

echo "[hook:pre-commit] running config checks"
./scripts/compile/check-configs.sh

echo "[hook:pre-commit] fixing em-dashes"
# Re-stage only the files that were already staged, so unrelated work in
# progress never slips into the commit.
staged=$(git diff --cached --name-only --diff-filter=ACM)
./scripts/dev/fix-emdash.sh
printf "%s\n" "$staged" | while IFS= read -r f; do
	[ -n "$f" ] && [ -f "$f" ] && git add -- "$f"
done

echo "[hook:pre-commit] ok"
