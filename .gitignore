!docs/methodology/**/*.log

# Python
__pycache__/
*.pyc

# Tooling
.vscode/
.idea/
compile_commands.json
coverage/

# CMake user-local overrides (not committed)
CMakeUserPresets.json
.vercel

# Astro / website build outputs
website/node_modules/
website/dist/
website/.astro/

# QEMU device-tree dumps from read-back: 1 MiB each, hashed in DUMP_SHA256SUMS
docs/methodology/**/machine.dtb

# Release bundles (scripts/release/make-try-bundle.sh)
dist/
