diff --git a/src/common/string.c b/src/common/string.c
index 015e3b1..2e1c683 100644
--- a/src/common/string.c
+++ b/src/common/string.c
@@ -31,6 +31,15 @@ void *hv_memcpy(void *dst, const void *src, size_t n)
 	return dst;
 }
 
+#ifdef HAVEN_ARCH_ARM64
+/* GCC can emit a memcpy libcall for aggregate copies in freestanding code.
+ * The haven/string.h macro only redirects calls present in the C source. */
+void *memcpy(void *dst, const void *src, size_t n)
+{
+	return hv_memcpy(dst, src, n);
+}
+#endif
+
 /* -----------------------------------------------------------------------
  * hv_memmove - copy n bytes allowing src/dst overlap.
  * ----------------------------------------------------------------------- */
diff --git a/src/core/exc/el2_exceptions.c b/src/core/exc/el2_exceptions.c
index 564532b..75bac42 100644
--- a/src/core/exc/el2_exceptions.c
+++ b/src/core/exc/el2_exceptions.c
@@ -365,6 +365,12 @@ void __attribute__((noreturn)) hv_fatal_exception(hv_u64 esr, hv_u64 far,
 	(void)elr;
 	(void)sp;
 #ifdef HAVEN_ARCH_ARM64
+	/* Preserve the fault context in the UART log before halting. */
+	if (hv_printk != NULL) {
+		hv_printk("EL2 FATAL: ESR=0x%lx FAR=0x%lx ELR=0x%lx\n",
+			  (unsigned long)esr, (unsigned long)far,
+			  (unsigned long)elr);
+	}
 	platform_uart_putchar('!');
 	platform_uart_putchar('E');
 	platform_uart_putchar('L');
