+/* E0 probe (not for merge): per CPU, injections that found the same
+ * vINTID already Pending (or Pending and active), or Active; hardware
+ * interrupts with no free LR; SGIs left in the request word. */
+static uint64_t read_ich_lr(unsigned int n);
+static uint32_t e0_dup_id[8], e0_dup_p[8], e0_dup_a[8], e0_hw_full[8],
+	e0_sgi_left[8];
+
+static void e0_scan(unsigned int n, uint32_t virq)
+{
+	extern uint32_t hv_arch_cpu_id(void);
+	uint32_t c = hv_arch_cpu_id();
+
+	if (c >= 8U)
+		return;
+	for (unsigned int i = 0; i < n; i++) {
+		uint64_t lr = read_ich_lr(i);
+		uint64_t st = (lr >> 62) & 3ULL;
+
+		if (st == 0ULL || (lr & 0x3FFULL) != virq)
+			continue;
+		e0_dup_id[c] = virq | ((uint32_t)st << 16);
+		if (st & 1ULL)
+			e0_dup_p[c]++;
+		else
+			e0_dup_a[c]++;
+	}
+}
